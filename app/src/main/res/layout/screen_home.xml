<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:padding="24dp" android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <ImageView android:src="@drawable/ic_bible" android:layout_width="120dp" android:layout_height="120dp"/>
        <TextView android:text="BÍBLIA" android:textSize="34sp" android:textStyle="bold"
            android:textColor="@color/gold" android:layout_marginTop="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="TODAS VERSÕES" android:textSize="20sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRead" android:text="📖  Ler a Bíblia"
            android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch" android:text="🔎  Pesquisar"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavorites" android:text="★  Favoritos"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings" android:text="⚙  Configurações"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="App criado por Thalyssonjsg"
            android:layout_marginTop="30dp" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
